PROTOCOLGUARD_ENV=development
DATABASE_URL=sqlite:///./protocolguard.db
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ML_ENABLED=true
ML_MODEL_DIRECTORY=ml/artifacts/bank-v2
RISK_FSM_WEIGHT=0.30
RISK_RF_WEIGHT=0.35
RISK_IF_WEIGHT=0.10
RISK_BEHAVIOR_WEIGHT=0.25
RISK_WINDOW_SECONDS=60
RISK_HALF_LIFE_SECONDS=600
RISK_MAX_EVENTS=200
AUTO_BLOCK_ENABLED=true
BLOCK_THRESHOLD=60
IP_AUTO_RESTRICT_ENABLED=true
IP_ABUSE_THRESHOLD=30
IP_ABUSE_WINDOW_SECONDS=60
IP_RESTRICTION_SECONDS=120
ML_COMPARISON_REPORT=ml/evaluation/comparison-v2.json
SIMULATION_ENABLED=true
# Hosting only: STATIC_DIRECTORY=/app/web
# PROVISION_DEMO_ACCOUNTS=false
# FORWARDED_ALLOW_IPS=verified-proxy-IP-or-CIDR
# API-only Railway hosting: SERVE_FRONTENDS=false
# Railway CORS_ORIGINS=https://your-project.vercel.app
# Vercel server-only environment: BACKEND_ORIGIN=https://your-api.up.railway.app
# No-card hosted backend: REQUIRE_POSTGRES=true
# DATABASE_URL: paste the private Neon connection string in Render Secrets only.
# Never commit a real hosted database URI or provisioning password.
# Optional signed Vercel visitor-IP forwarding. Set the same private random secret
# on Render and Vercel; Render Blueprint can generate it. Never use a VITE_ prefix.
CLIENT_IP_SIGNING_SECRET=
# Enable only after both signing keys are configured and verified.
REQUIRE_SIGNED_CLIENT_IP=false
