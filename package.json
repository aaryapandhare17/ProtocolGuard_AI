{
  "name": "protocolguard-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:bank": "npm run dev --workspace @protocolguard/securebank",
    "dev:admin": "npm run dev --workspace @protocolguard/admin",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:deployment": "node scripts/smoke-deployment.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "test:proxy": "node --test scripts/tests/proxy.test.cjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  },
  "engines": {
    "node": "22.x"
  }
}
